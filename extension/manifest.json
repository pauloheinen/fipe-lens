{
  "manifest_version": 3,
  "name": "Marketplace FIPE Lens",
  "version": "0.1.1",
  "key": "",
  "description": "Compara anúncios de motos do Marketplace com a FIPE e destaca fatores para avaliar a compra.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "https://www.facebook.com/marketplace/*",
    "https://parallelum.com.br/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Configurar FIPE Lens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
